# SignalScan environment template — PRD §21
#
# Copy to .env.local and fill in. NEVER commit real secrets.
#   cp .env.example .env.local          (bash)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# `db:migrate` and `db:seed` read .env.local automatically. An environment
# variable set in the shell always wins over the file.
#
# Every value below is safe to commit. Blank values are required at runtime and
# will be validated at startup once the application exists — the process must
# fail closed rather than start with a missing credential.

# ─── §21.1 Application ────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=SignalScan
APP_DEFAULT_TIMEZONE=Asia/Kolkata
APP_DEFAULT_CURRENCY=INR
LOG_LEVEL=info

# ─── §21.2 Database ───────────────────────────────────────────────────────────
# Matches docker-compose.yml. Swap for a Supabase pooled URL in staging/prod.
DATABASE_URL=postgresql://signalscan:signalscan@localhost:5432/signalscan
DATABASE_DIRECT_URL=postgresql://signalscan:signalscan@localhost:5432/signalscan
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ─── §21.3 Authentication ─────────────────────────────────────────────────────
# AUTH_PROVIDER=local uses the dev magic-link stub (mail lands in Mailpit).
# Set to `supabase` once a project exists and fill the SUPABASE_* block.
AUTH_PROVIDER=local
AUTH_SECRET=
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_INVITE_TTL_SECONDS=604800

# Provider-specific. The service-role key is server-only — never expose to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── §21.4 Storage ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=minio targets the local container. `supabase` for hosted.
STORAGE_PROVIDER=minio
STORAGE_PRIVATE_BUCKET=signalscan-private
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=signalscan
STORAGE_SECRET_KEY=signalscan-dev-secret
FILE_MAX_SIZE_MB=50
ASSESSMENT_MAX_FILE_COUNT=200
ASSESSMENT_MAX_STORAGE_MB=2048
ALLOWED_FILE_EXTENSIONS=pdf,docx,pptx,txt,md,csv,xlsx,png,jpg,jpeg,webp

# ─── §21.5 Jobs ───────────────────────────────────────────────────────────────
# The Inngest dev server runs offline with no account and no keys.
JOB_PROVIDER=inngest
JOB_SIGNING_KEY=
JOB_EVENT_KEY=
JOB_MAX_ATTEMPTS=3
JOB_ANALYSIS_TIMEOUT_SECONDS=1800

# ─── §21.6 LLM and embeddings ─────────────────────────────────────────────────
# LLM_PROVIDER=mock replays the gold fixtures in tests/fixtures — deterministic,
# no network, no key. Switch to `anthropic` and set LLM_API_KEY for live runs.
#
# Model names are NEVER defaulted in code (§21.6). Startup fails if a model slot
# is empty while LLM_PROVIDER is not `mock`.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_EXTRACTION=claude-opus-5
LLM_MODEL_CLASSIFICATION=claude-haiku-4-5
LLM_MODEL_GENERATION=claude-opus-5
LLM_MODEL_REPORT=claude-opus-5
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LLM_MAX_REPAIR_ATTEMPTS=1
LLM_LOG_CONTENT=false

# ─── §21.7 Email ──────────────────────────────────────────────────────────────
# Local Mailpit captures everything; nothing leaves the machine.
EMAIL_PROVIDER=mailpit
EMAIL_API_KEY=
EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=signalscan@example.com
EMAIL_REPLY_TO=

# ─── §21.8 PDF and malware scanning ───────────────────────────────────────────
# Production startup MUST fail closed when scanning is required but unconfigured.
PDF_RENDERER=chromium
PDF_RENDERER_URL=
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_PROVIDER=stub
MALWARE_SCAN_API_KEY=

# ─── §21.9 Retention and exports ──────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=90
MIN_RETENTION_DAYS=30
MAX_RETENTION_DAYS=365
EXPORT_LINK_TTL_SECONDS=86400
RETENTION_CRON_SECRET=

# ─── §21.10 Monitoring ────────────────────────────────────────────────────────
# No client content may enter logs, traces or analytics (§22.1, §24.1).
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=

# ─── §21.11 Feature flags ─────────────────────────────────────────────────────
FEATURE_BRAND_INFERENCE=true
FEATURE_COMPETITOR_ANALYSIS=true
FEATURE_PDF_EXPORT=true
FEATURE_CLIENT_RAW_EXPORT=false
FEATURE_PUBLIC_DEMO=false
