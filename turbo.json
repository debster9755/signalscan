{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL", "NEXT_PUBLIC_APP_URL", "APP_ENV", "LOG_LEVEL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL", "NEXT_PUBLIC_APP_URL", "APP_ENV", "LOG_LEVEL"]
    }
  },
  "globalEnv": ["NODE_ENV"]
}
