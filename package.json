{
  "name": "signalscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SignalScan \u2014 a five-day AI Marketing Opportunity Scan. Strategist evidence and decision system.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "dev": "turbo run dev",
    "dev:services": "docker compose up -d",
    "dev:services:down": "docker compose down",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/migrate.ts --reset && tsx db/seed.ts",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:evals": "vitest run --project evals --passWithNoTests",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@signalscan/domain": "workspace:*",
    "dotenv": "^17.4.2",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  }
}
