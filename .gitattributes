# Normalise line endings so the repo is identical on Windows, macOS and CI.
* text=auto eol=lf

# Lockfile is generated — keep diffs out of review.
pnpm-lock.yaml linguist-generated=true -diff

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary
